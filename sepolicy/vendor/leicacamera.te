# priv_app
hal_client_domain(priv_app, vendor_hal_camerapostproc_xiaomi)
allow priv_app vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
binder_call(priv_app, hal_camera_default)
binder_call(hal_camera_default, priv_app)
binder_call(priv_app, vendor_hal_camerapostproc_xiaomi)
get_prop(priv_app, vendor_camera_sensor_prop)
get_prop(priv_app, vendor_panel_info_prop)
get_prop(priv_app, vendor_display_prop)
allow priv_app adsprpcd_file:dir { getattr open read search };
allow priv_app vendor_xdsp_device:chr_file { ioctl open read write };
allow priv_app vendor_qdsp_device:chr_file { ioctl open read write };
allow priv_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow priv_app vendor_camera_data_file:file { getattr open read write };

