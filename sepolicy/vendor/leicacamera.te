# zeus / Android 17: extra permissions seen as denials with the module build
get_prop(priv_app_36, vendor_audio_prop)
get_prop(priv_app_36, vendor_camera_p3enable_prop)
get_prop(priv_app, vendor_audio_prop)
get_prop(priv_app, vendor_camera_p3enable_prop)
allow priv_app_36 app_data_file:file execute;
allow priv_app app_data_file:file execute;
